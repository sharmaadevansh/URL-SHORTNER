# Multi-stage Dockerfile for LinkForge Analytics Worker
FROM node:20-alpine AS deps

WORKDIR /app

COPY package*.json ./
COPY packages/shared/package*.json ./packages/shared/
COPY apps/worker/package*.json ./apps/worker/

RUN npm ci --omit=dev

FROM node:20-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production

USER node

COPY --chown=node:node --from=deps /app/package*.json ./
COPY --chown=node:node --from=deps /app/node_modules ./node_modules
COPY --chown=node:node packages/shared/src ./packages/shared/src
COPY --chown=node:node packages/shared/package*.json ./packages/shared/
COPY --chown=node:node apps/worker/src ./apps/worker/src
COPY --chown=node:node apps/worker/package*.json ./apps/worker/

CMD ["node", "apps/worker/src/index.js"]
