# infra/terraform/terraform.tfvars
# =============================================================
# Fill in your values, then run: terraform apply
# This file is safe to commit ONLY because it has no secrets.
# =============================================================

aws_region    = "us-east-1"
environment   = "production"
instance_type = "t3.small"
ssh_key_name  = "linkforge-key"

# Your public IP — find it at: https://checkip.amazonaws.com
# Format: "YOUR_IP/32"  e.g.  "203.0.113.42/32"
allowed_ssh_cidr = "YOUR_IP/32"
