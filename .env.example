# Application Environment
NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
PUBLIC_APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/linkforge

# Redis Connection
REDIS_URL=redis://localhost:6379

# Authentication Secrets (Generate secure random strings for production)
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-for-jwt-access-linkforge-production
JWT_REFRESH_SECRET=replace-with-another-long-random-secret-for-jwt-refresh-linkforge-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Observability & Logging
LOG_LEVEL=debug
METRICS_ENABLED=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
